# Local development only. Hosted values belong in the deployment secret store.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_SECRET_KEY_FALLBACKS=
DJANGO_DEBUG=true
DJANGO_SQLITE_TEST=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# The local database credentials match compose.yaml.
DATABASE_URL=postgresql://veyra:veyra@127.0.0.1:5432/veyra
REDIS_URL=redis://127.0.0.1:6379/0
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=
PAYMENT_CREDENTIALS_ENCRYPTION_FALLBACK_KEYS=
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback/
ACCOUNT_SECURITY_ENCRYPTION_KEY=
ACCOUNT_SECURITY_ENCRYPTION_FALLBACK_KEYS=
# Defaults to true outside debug mode; set true locally to test required owner/admin enrollment.
# MFA_REQUIRE_PRIVILEGED=true

# Platform SaaS billing. Use a separate Veyra Midtrans merchant and configured HTTPS origin.
VEYRA_BILLING_MIDTRANS_ENV=sandbox
VEYRA_BILLING_MIDTRANS_SERVER_KEY=
VEYRA_BILLING_MIDTRANS_SIGNATURE_SECRET_KEY=
VEYRA_BILLING_PUBLIC_ORIGIN=

# Staging origins and runtime (optional in local development).
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_HSTS_SECONDS=3600
# Remote PostgreSQL: use a session-capable DSN with sslmode=verify-full and a trusted CA.
# Remote Valkey: use a rediss:// DSN with certificate verification.
DEFAULT_FROM_EMAIL="Veyra <accounts@veyra.app>"
RESEND_API_KEY=
SUPABASE_MEDIA_URL=
SUPABASE_MEDIA_BUCKET=
SUPABASE_SERVICE_ROLE_KEY=
